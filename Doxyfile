# Generate the documented class API. Implementation comments remain in src/.
PROJECT_NAME           = assignment2_final
PROJECT_BRIEF          = "C++ fantasy game: classes, ownership and command flow"
OUTPUT_DIRECTORY       = docs-generated
OUTPUT_LANGUAGE        = English
INPUT                  = src src/main.cpp docs/doxygen-main.md
USE_MDFILE_AS_MAINPAGE  = docs/doxygen-main.md
FILE_PATTERNS          = *.h
RECURSIVE              = NO
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
WARN_LOGFILE           = docs-generated/doxygen-warnings.log
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
UML_LOOK               = YES
DOT_NUM_THREADS        = 1
NUM_PROC_THREADS       = 1
QUIET                  = YES
PREDEFINED             = "Q_OBJECT=" "slots="

# Header API plus the standalone application entry point.
SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
VERBATIM_HEADERS       = YES
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .
